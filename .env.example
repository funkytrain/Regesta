# Regesta configuration.
#
# Every value here is a default: the application runs with none of them set.
# Copy to .env only if you want to change something.

# The archive profile: the vocabulary of your file names. Either the id of a
# bundled profile (es-parish, en-parish, pt-parish) or a path to your own.
# See profiles/README.md.
REGESTA_PROFILE=es-parish

REGESTA_PORT=8080

# The only two things the application writes.
REGESTA_DB=data/regesta.db
REGESTA_THUMBNAILS=data/thumbnails

# Folder watching: new documents are indexed on their own. 0 turns it off.
REGESTA_WATCH=1

# Minutes between full sweeps, on top of the watching. It picks up whatever
# the file system notifications miss. 0 disables them.
REGESTA_SWEEP_MIN=360

# Set to 1 to poll the disk instead of waiting for notifications. Needed on
# network shares, where notifications often never arrive.
REGESTA_POLLING=0

# fatal | error | warn | info | debug | trace
REGESTA_LOG=info
