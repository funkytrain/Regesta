{
  "name": "regesta",
  "version": "0.1.0",
  "type": "module",
  "description": "Archival cataloguing for a genealogical document collection",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "node dist/server/main.js",
    "build": "tsc -p tsconfig.json",
    "index": "tsx src/indexer/cli.ts",
    "index-text": "tsx src/indexer/index-text.ts",
    "detect-profile": "tsx src/indexer/detect-profile-cli.ts",
    "stats": "tsx src/indexer/stats.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.4",
    "chokidar": "^4.0.3",
    "fastify": "^5.2.0",
    "mammoth": "^1.12.3",
    "pdfjs-dist": "^4.10.38",
    "sharp": "^0.35.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "playwright": "^1.63.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "license": "MIT",
  "keywords": [
    "genealogy",
    "archive",
    "isad-g",
    "gramps",
    "self-hosted",
    "cataloguing"
  ]
}
